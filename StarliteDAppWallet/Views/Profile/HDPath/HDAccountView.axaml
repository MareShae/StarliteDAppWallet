<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StarliteDAppWallet.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StarliteDAppWallet.Views.HDAccountView"
             x:DataType="vm:HDAccountViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:HDAccountViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="*, 5*,*" ColumnDefinitions="*, 5*,*">
    <Border Grid.Row="1" Grid.Column="1"
        BorderBrush="Black"
        BorderThickness="2" >
        <Grid RowDefinitions="Auto, Auto, *">
            <TextBlock Grid.Row="0"
                Text="Heirachical Deterministic Pathway" />

            <Button Grid.Row="1"
                Command="{Binding OnAlias}"
                Background="Transparent"
                BorderBrush="Transparent" >
                <TextBlock Text="{Binding RootAlias}" />
            </Button>

            <ScrollViewer Grid.Row="2"
            VerticalScrollBarVisibility="Auto" >
            <Panel>

                <ItemsControl Grid.Row="2" IsVisible="{Binding IsPasslist}" ItemsSource="{Binding Passlist}">

                    <!-- StackPanel arrange profiles neatly  -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <!-- Content is produced in a ContentPresenter, Canvas props do not -->
                        <DataTemplate>

                            <Button Command="{Binding $parent[ItemsControl].DataContext.OnPassClicked}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderBrush="Transparent" >

                                <TextBlock>
                                    <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} #{1}">
                                        <Binding Path="Alias" />
                                        <Binding Path="HDIndex" />
                                    </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>

                            </Button>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <StackPanel Grid.Row="2" Orientation="Vertical" IsVisible="{Binding IsSeedHDPath}">
                    <TextBlock Text="Passphrase" />
                    <TextBox
                        Text="{Binding Passphrase}"
                        PlaceholderText="{Binding PassphrasePlaceholder}"
                        PlaceholderForeground="Black" />

                    <TextBlock Text="Path" />
                    <TextBox
                        Text="{Binding HDIndex}"
                        PlaceholderText="{Binding PathPlaceholder}"
                        PlaceholderForeground="Black" />

                    <Button Content="save" Command="{Binding OnSaveSeedHDPath}" />
                    <Button Content="cancel" Command="{Binding OnCancelSeedHDPath}" />
                </StackPanel>
            </Panel>
            </ScrollViewer>
        </Grid>
    </Border>
    </Grid>
</UserControl>
