<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:StarliteDAppWallet.ViewModels"
             xmlns:addon="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
             xmlns:custom="using:StarliteDAppWallet.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="StarliteDAppWallet.Views.dAppsView"
             x:DataType="vm:dAppsViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:dAppsViewModel />
    </Design.DataContext>

    <!-- 
        Avalonia.Controls.WebView is separate from the core Avalonia
            1. Add as package to dotnet
            2. In axaml, include as custom xmlns:addon="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.WebView"
            3. Use as addon:NativeWebView
    -->

    <Grid x:Name="WebViewGrid" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Button Grid.Column="0"
                Content="Back"
                Command="{Binding CommandNavigateBack}"
                HorizontalAlignment="Left" />

            <!-- {Binding WebViewsource} -->
            <Panel Grid.Column="1">
                <TextBox x:Name="CurrentWebAddrBox"
                    PlaceholderText="Address goes here..."
                    Text="{Binding CurrentWebAddr}"
                    KeyDown="OnCurrentWebAddrKeyDown"
                    HorizontalAlignment="Stretch" />

                <Button x:Name="CurrentWebAddrEditGo"
                    IsVisible="false"
                    Command="{Binding OnCurrentWebAddrEditKey}" />
            </Panel>

            <Button Grid.Column="2"
                Content="Fore"
                Command="{Binding CommandNavigateFore}"
                HorizontalAlignment="Right" />
        </Grid>

        <Panel Grid.Row="1">
            <TextBlock Text="Saved pages go here"
                VerticalAlignment="Center"
                HorizontalAlignment="Center" />
        </Panel>
    </Grid>

</UserControl>
